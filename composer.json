{
    "name": "omnigame/steam",
    "type": "library",
    "description": "Omnigame's Steam, under any PHP host: an app's store record and the store's search with no key (price in the country asked, texts in the language asked), a player's library and whether they own a game with a Steam Web API key.",
    "keywords": [
        "steam",
        "valve",
        "store",
        "game",
        "games",
        "library",
        "framework-agnostic",
        "omnigame"
    ],
    "homepage": "https://github.com/glitchr-studio/omnigame-steam",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omniscient/omnigame": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnigame\\Steam\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnigame\\Steam\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
